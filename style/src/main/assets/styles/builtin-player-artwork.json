      "extent": "FULL_SCREEN",
      "layers": [
        {
          "kind": "ALBUM_ART",
          "scale": 1.2,
          "alpha": 1,
          "blend": "NORMAL"
        },
        {
          "kind": "BLUR",
          "radiusDp": 48,
          "extent": "FULL_SCREEN",
          "alpha": 0.6,
          "blend": "NORMAL"
        },
        {
          "kind": "GRADIENT",
          "anchor": "TOP_AND_BOTTOM",
          "startColor": "SCRIM",
          "endColor": "BACKGROUND",
          "artTint": 0.2,
          "alpha": 0.5,
          "blend": "NORMAL"
        }
      ]
